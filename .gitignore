com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# Editor-based Rest Client
.idea/httpRequests

# Android studio 3.1+ serialized cache file
.idea/caches/build_file_checksums.ser

.env
*.pyc
*.env
# `.env` matches exactly and `*.env` only matches a suffix, so neither covers
# `.env.live` or any other `.env.<name>` variant. Live credentials live in one
# of those, so spell the prefix form out.
.env.*
!.env.example
credentials-*.json
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
build/

debug.log

# Demo directory (not committed)
demo/
.claude
.venv
plans/

# Active/local runtime and release artifacts
config.yaml
*.tfvars
*.tfvars.json
test-results/
playwright-report/
trace.zip
audit-spool/
*.spool
*.deadletter
credentials*.json
service-account*.json
*.pem
*.p12
*.pfx

# Local compose overrides (see docker-compose.override.yml.example)
